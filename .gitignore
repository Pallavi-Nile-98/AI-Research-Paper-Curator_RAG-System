# ---------------------------------------------------------------------------
# Secrets and local configuration
# ---------------------------------------------------------------------------
# .env holds real credentials. Only .env.example (placeholders) is committed.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
credentials.json

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib60/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/

# Test / coverage / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.tox/
.nox/

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
frontend/coverage/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Project data — large, regenerable, or licence-encumbered. Never commit.
# ---------------------------------------------------------------------------
# Downloaded arXiv PDFs and extracted text
data/
*.pdf
!tests/fixtures/**/*.pdf          # small, checked-in test fixtures are allowed

# Local model weights (embeddings, cross-encoder, Ollama blobs).
#
# Leading slash matters: a bare `models/` matches at ANY depth, which silently
# excluded src/paper_curator/db/models/ -- a source package. Anchoring to the
# repository root keeps the rule to downloaded weights, which is what it means.
/models/
*.gguf
*.safetensors
*.bin
.cache/
.huggingface/

# Docker named-volume mounts, if ever bind-mounted locally
volumes/
pgdata/
opensearch-data/

# Airflow local runtime artefacts
airflow/logs/
airflow/plugins/__pycache__/
airflow.db
airflow.cfg
webserver_config.py

# ---------------------------------------------------------------------------
# Evaluation artefacts
# ---------------------------------------------------------------------------
# Reports and datasets ARE committed (they are portfolio evidence).
# Only raw scratch output is ignored.
evaluation/**/_scratch/
evaluation/**/*.tmp.json

# ---------------------------------------------------------------------------
# Terraform
# ---------------------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
override.tf
override.tf.json

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json.example
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
