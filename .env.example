# =============================================================================
# AI Research Paper Curator -- example environment file
# =============================================================================
#
#   cp .env.example .env        (PowerShell:  Copy-Item .env.example .env)
#
# .env is git-ignored; this file is committed. NEVER put a real credential here.
#
# Every variable below is optional: src/paper_curator/core/config.py defines a
# working default for each one. Uncomment a line only to override it.
#
# Naming: the prefix maps to a settings class in core/config.py, so POSTGRES_HOST
# is PostgresSettings.host. Values are validated and type-coerced at startup, so a
# typo fails immediately and loudly rather than at first use.
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENVIRONMENT=local              # local | ci | production
APP_DEBUG=false
APP_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_FORMAT=console             # console (human-readable) | json (CI, Docker, CloudWatch)


# -----------------------------------------------------------------------------
# PostgreSQL -- pipeline state and relational truth
# -----------------------------------------------------------------------------
# Owns papers, authors, ingestion runs, checkpoints, processing status, queries
# and feedback. It is deliberately NOT the search engine (see ADR-0002).
POSTGRES_HOST=localhost
# 5433, not 5432: a native Postgres already listens on 5432 on this machine, so
# the container publishes to 5433. Inside the Docker network the port is 5432.
POSTGRES_PORT=5433
POSTGRES_USER=curator
# Local development password only. Production reads this from AWS Secrets Manager.
POSTGRES_PASSWORD=curator_local_dev
POSTGRES_DATABASE=paper_curator
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_ECHO_SQL=false            # true logs every SQL statement; noisy but useful


# -----------------------------------------------------------------------------
# OpenSearch -- the retrieval surface
# -----------------------------------------------------------------------------
# Holds chunk text for BM25 lexical scoring and dense vectors for k-NN search,
# in the same document so hybrid retrieval hits one engine (see ADR-0004).
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
# The local container runs with the security plugin DISABLED, so there is no TLS
# and no credentials. That is acceptable for a localhost-only dev container and
# unacceptable in production -- AWS uses TLS plus fine-grained access control.
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=
# Reads and writes target an ALIAS, never a concrete index. Re-indexing under a
# new mapping then becomes an atomic alias swap instead of downtime.
OPENSEARCH_INDEX_ALIAS=papers-current
OPENSEARCH_INDEX_PREFIX=papers
OPENSEARCH_REQUEST_TIMEOUT_SECONDS=30
OPENSEARCH_MAX_RETRIES=3
OPENSEARCH_BULK_BATCH_SIZE=100


# -----------------------------------------------------------------------------
# Ollama -- local LLM serving
# -----------------------------------------------------------------------------
# Runs as a Docker service (profile: llm). Pull the model once it is up:
#   docker-compose --profile llm exec ollama ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Generous timeout: this machine has no CUDA GPU, so generation is CPU-bound and
# slow. Expect single-digit tokens per second.
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=2
# Low temperature: this is a grounded question-answering system, not a creative
# writing tool. We want the model to stick to the retrieved evidence.
OLLAMA_TEMPERATURE=0.1
OLLAMA_MAX_OUTPUT_TOKENS=1024


# -----------------------------------------------------------------------------
# Embeddings -- dense vector retrieval
# -----------------------------------------------------------------------------
# EMBEDDING_DIMENSIONS must match the knn_vector dimension in the OpenSearch
# mapping. Changing the model therefore REQUIRES a full re-index under a new
# index version -- vectors from different models are not comparable.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu               # no CUDA GPU on this machine
EMBEDDING_NORMALIZE=true           # unit vectors make cosine similarity a dot product


# -----------------------------------------------------------------------------
# Re-ranking -- precision pass over the fused candidate pool
# -----------------------------------------------------------------------------
# Retrieve a wide pool cheaply, then re-score it with a slower, more accurate
# cross-encoder, then keep only the best few for the prompt.
RERANKER_ENABLED=true
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=16
RERANKER_CANDIDATE_POOL_SIZE=50
RERANKER_TOP_K=5
RERANKER_TIMEOUT_SECONDS=10        # on timeout we fall back to un-reranked results


# -----------------------------------------------------------------------------
# arXiv ingestion
# -----------------------------------------------------------------------------
ARXIV_BASE_URL=http://export.arxiv.org/api/query
# Comma-separated. cs.CL = computation and language, cs.IR = information
# retrieval, cs.LG = machine learning.
ARXIV_CATEGORIES=cs.CL,cs.IR,cs.LG
ARXIV_PAGE_SIZE=100
ARXIV_MAX_RESULTS_PER_RUN=200
# arXiv's terms of use ask for at least 3 seconds between requests. Do not lower
# this -- it is a courtesy limit on a free public service, not a performance knob.
ARXIV_MIN_REQUEST_INTERVAL_SECONDS=3
ARXIV_REQUEST_TIMEOUT_SECONDS=30
ARXIV_MAX_RETRIES=3
ARXIV_MAX_PDF_BYTES=52428800       # 50 MB cap; refuse anything larger


# -----------------------------------------------------------------------------
# Langfuse -- LLM observability (OPTIONAL)
# -----------------------------------------------------------------------------
# Leave both keys blank and tracing is simply disabled; the application runs
# normally. Observability must never be load-bearing.
#
# To enable: create a free project at https://cloud.langfuse.com, then paste the
# keys into your .env (NOT into this file -- this one is committed).
#
# Traces leave your machine and go to Langfuse's servers, so the tracing layer
# must not attach secrets or unnecessary personal data.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com    # use https://cloud.langfuse.com for the EU region


# -----------------------------------------------------------------------------
# FastAPI
# -----------------------------------------------------------------------------
# Loopback by default. The container overrides this to 0.0.0.0 explicitly, so
# binding to every interface is always deliberate rather than accidental.
API_HOST=127.0.0.1
# 8002, not 8000: ports 8000 and 8001 are already occupied on this machine.
API_PORT=8002
API_CORS_ORIGINS=http://localhost:5173         # comma-separated; Vite dev server
API_MAX_REQUEST_BYTES=1048576                  # 1 MB
API_RATE_LIMIT_PER_MINUTE=60
API_REQUEST_TIMEOUT_SECONDS=180


# =============================================================================
# Docker Compose only -- read by docker-compose.yml, not by the application
# =============================================================================
# Host-side published ports. Change these if something else grabs the port.
OPENSEARCH_HOST_PORT=9200
OPENSEARCH_PERF_PORT=9600
OPENSEARCH_DASHBOARDS_PORT=5601
OLLAMA_HOST_PORT=11434

# JVM heap for OpenSearch. Must be set to no more than 50% of the container's
# memory limit, and -Xms must equal -Xmx to stop the heap resizing at runtime.
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
